        setNewProductForm({
          name: '',
          categoryId: categories[0]?.id || 'cat-cctv',
          brand: brands[0]?.name || 'Hikvision',
          price: '',
          regularPrice: '',
          stock: '',
          warranty: '1 Year Official Warranty',
