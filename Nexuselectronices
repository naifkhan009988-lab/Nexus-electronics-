                                    <option value="Processing">Processing</option>
                                    <option value="Shipped">Shipped</option>
                                    <option value="Delivered">Delivered</option>
                                    <option value="Cancelled">Cancelled</option>
                                  </select>
                                </div>
                              </div>

                              <div className="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-2 border-t border-slate-200">
                                <div>
                                  <p className="text-slate-600"><strong>Customer:</strong> {order.customer.name} ({order.customer.phone})</p>
                                  <p className="text-slate-600"><strong>Address:</strong> {order.customer.address} - {order.customer.city}</p>
                                </div>
                                <div className="sm:text-right">
                                  <p className="text-slate-600"><strong>Payment:</strong> {order.customer.paymentMethod}</p>
                                  <p className="font-extrabold text-sm text-sky-700">Total: {formatBDT(order.total)}</p>
                                </div>
                              </div>

                              <div className="pt-2 text-slate-500">
                                <strong>Items:</strong> {order.items.map(i => `${i.name} (x${i.quantity})`).join(', ')}
                              </div>
                            </div>
                          ))
                        )}
                      </div>
                    )}

                    {/* Settings Tab */}
                    {adminTab === 'settings' && (
                      <div className="bg-slate-50 p-4 rounded-2xl border border-slate-200 space-y-4">
                        <h4 className="text-sm font-extrabold text-slate-900">Manage Hotline & Delivery Settings</h4>

                        <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
                          <div>
                            <label className="block font-bold text-slate-700 mb-1">Hotline Phone Number</label>
                            <input
                              type="text"
                              value={settings.hotline}
                              onChange={(e) => setSettings({ ...settings, hotline: e.target.value })}
                              placeholder="+880 1891-XXXXXX"
                              className="w-full px-3 py-2 border rounded-xl bg-white"
                            />
                          </div>

                          <div>
                            <label className="block font-bold text-slate-700 mb-1">WhatsApp Contact Number</label>
                            <input
                              type="text"
                              value={settings.whatsapp}
                              onChange={(e) => setSettings({ ...settings, whatsapp: e.target.value })}
                              placeholder="+880 1891-XXXXXX"
                              className="w-full px-3 py-2 border rounded-xl bg-white"
                            />
                          </div>

                          <div>
                            <label className="block font-bold text-slate-700 mb-1">Dhaka Delivery Fee (৳)</label>
                            <input
                              type="number"
                              value={settings.dhakaFee}
                              onChange={(e) => setSettings({ ...settings, dhakaFee: Number(e.target.value) })}
                              className="w-full px-3 py-2 border rounded-xl bg-white"
                            />
                          </div>

                          <div>
                            <label className="block font-bold text-slate-700 mb-1">Cumilla Delivery Fee (৳)</label>
                            <input
                              type="number"
                              value={settings.cumillaFee}
                              onChange={(e) => setSettings({ ...settings, cumillaFee: Number(e.target.value) })}
                              className="w-full px-3 py-2 border rounded-xl bg-white"
                            />
                          </div>

                          <div className="sm:col-span-2">
                            <label className="block font-bold text-slate-700 mb-1">Top Announcement Notice</label>
                            <input
                              type="text"
                              value={settings.announcement}
                              onChange={(e) => setSettings({ ...settings, announcement: e.target.value })}
                              className="w-full px-3 py-2 border rounded-xl bg-white"
                            />
                          </div>

                          <div className="sm:col-span-2">
                            <label className="block font-bold text-slate-700 mb-1">Store Address / Showrooms</label>
                            <input
                              type="text"
                              value={settings.address}
                              onChange={(e) => setSettings({ ...settings, address: e.target.value })}
                              className="w-full px-3 py-2 border rounded-xl bg-white"
                            />
                          </div>
                        </div>

                        <p className="text-[11px] text-emerald-600 font-bold">
                          ✓ Any changes made here immediately save and update the customer-facing website and hotline links!
                        </p>
                      </div>
                    )}
                  </div>
                )}
              </div>
            </div>
          )}

          {/* Footer */}
          <footer className="bg-navy-950 text-slate-400 text-xs py-12 px-4 border-t border-slate-800 mt-auto">
            <div className="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 mb-8">
              <div className="space-y-3">
                <div className="flex items-center gap-2 text-white font-extrabold text-base">
                  <div className="w-8 h-8 rounded-lg bg-sky-600 flex items-center justify-center text-white">N</div>
                  <span>YOUR NEXUS BD</span>
                </div>
                <p className="text-slate-400 leading-relaxed">
                  Your trusted electronics and security systems destination in Bangladesh. 100% genuine products with official warranty.
                </p>
                <div className="text-slate-300">
                  <p><strong>Hotline:</strong> {settings.hotline || 'Contact Us'}</p>
                  <p><strong>Showroom:</strong> {settings.address}</p>
                </div>
              </div>

              <div>
                <h4 className="font-extrabold text-white text-sm mb-3">Top Categories</h4>
                <ul className="space-y-2">
                  {categories.slice(0, 5).map(c => (
                    <li key={c.id}>
                      <button onClick={() => { setSelectedCategory(c.id); window.scrollTo({ top: 300, behavior: 'smooth' }); }} className="hover:text-sky-400 transition">
                        {c.name}
                      </button>
                    </li>
                  ))}
                </ul>
              </div>

              <div>
                <h4 className="font-extrabold text-white text-sm mb-3">Customer Care</h4>
                <ul className="space-y-2">
                  <li><button onClick={() => setIsOrderTrackerOpen(true)} className="hover:text-sky-400 transition">Track Your Order</button></li>
                  <li><span className="text-slate-400">Dhaka Delivery: ৳{settings.dhakaFee}</span></li>
                  <li><span className="text-slate-400">Cumilla Delivery: ৳{settings.cumillaFee}</span></li>
                  <li><span className="text-slate-400">Warranty & Replacement Policy</span></li>
                </ul>
              </div>

              <div>
                <h4 className="font-extrabold text-white text-sm mb-3">Payment & Trust</h4>
                <p className="text-slate-400 mb-3 leading-relaxed">
                  We accept Cash on Delivery across Dhaka & Cumilla, as well as bKash and Nagad mobile banking.
                </p>
                <div className="flex flex-wrap gap-2 text-[10px] font-bold text-slate-300">
                  <span className="bg-slate-800 px-2 py-1 rounded">Cash on Delivery</span>
                  <span className="bg-slate-800 px-2 py-1 rounded">bKash</span>
                  <span className="bg-slate-800 px-2 py-1 rounded">Nagad</span>
                </div>
              </div>
            </div>

            <div className="max-w-7xl mx-auto pt-6 border-t border-slate-800 flex flex-col sm:flex-row justify-between items-center gap-4 text-slate-500 text-[11px]">
              <div>© {new Date().getFullYear()} Your Nexus Bangladesh. All rights reserved.</div>
              <div className="flex items-center gap-4">
                <button onClick={() => setIsAdminOpen(true)} className="hover:text-sky-400 transition">
                  Admin Login
                </button>
                <span>•</span>
                <span>Self-Contained Single File Edition (No Build Step)</span>
              </div>
            </div>
          </footer>
        </div>
      );
    }

    // Render to DOM
    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<App />);
  </script>
</body>
</html>
