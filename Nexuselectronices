      const handleTrackOrder = (e) => {
        e.preventDefault();
        setTrackingError('');
        setTrackedOrder(null);
        const query = trackingInput.trim().toUpperCase();
        if (!query) return;

        const found = orders.find(o => o.id === query || o.customer.phone.includes(query));
        if (found) {
          setTrackedOrder(found);
        } else {
          setTrackingError('No order found matching tracking number or phone number.');
        }
      };

      // Admin Login
      const handleAdminLogin = (e) => {
        e.preventDefault();
        if (adminPassInput === 'admin123' || adminPassInput === 'nexus2026') {
          setIsAdminLoggedIn(true);
          setAdminLoginError('');
          setAdminPassInput('');
        } else {
          setAdminLoginError('Invalid administrator credentials.');
