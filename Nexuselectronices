        categoryId: 'cat-cctv',
        brand: 'Hikvision',
        price: '',
        regularPrice: '',
        stock: '',
        warranty: '1 Year Official Warranty',
        image: '',
        description: '',
        specs: ''
      });

      // Cart Calculations & Handlers
      const addToCart = (product, quantity = 1) => {
        setCart(prev => {
          const existing = prev.find(item => item.id === product.id);
          if (existing) {
            return prev.map(item => item.id === product.id ? { ...item, quantity: item.quantity + quantity } : item);
          }
          return [...prev, { ...product, quantity }];
        });
        setIsCartOpen(true);
      };

      const updateQuantity = (id, delta) => {
        setCart(prev => prev.map(item => {
          if (item.id === id) {
            const newQty = item.quantity + delta;
            return newQty > 0 ? { ...item, quantity: newQty } : null;
          }
          return item;
        }).filter(Boolean));
      };

      const removeFromCart = (id) => {
        setCart(prev => prev.filter(item => item.id !== id));
      };

      const cartSubtotal = useMemo(() => {
        return cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
      }, [cart]);

      const cartCount = useMemo(() => {
        return cart.reduce((sum, item) => sum + item.quantity, 0);
      }, [cart]);

      const deliveryFee = useMemo(() => {
        if (checkoutForm.city === 'Dhaka') return settings.dhakaFee;
        if (checkoutForm.city === 'Cumilla') return settings.cumillaFee;
        return settings.outsideFee;
      }, [checkoutForm.city, settings]);

      const orderGrandTotal = cartSubtotal + deliveryFee;

      // Filtered Products Search & Categories
      const filteredProducts = useMemo(() => {
        return products.filter(p => {
          const matchQuery = !searchQuery.trim() ||
            p.name.toLowerCase().includes(searchQuery.toLowerCase()) ||
            p.brand.toLowerCase().includes(searchQuery.toLowerCase()) ||
            p.categoryName.toLowerCase().includes(searchQuery.toLowerCase());
          const matchCat = !selectedCategory || p.categoryId === selectedCategory;
          const matchBrand = !selectedBrand || p.brand.toLowerCase() === selectedBrand.toLowerCase();
          return matchQuery && matchCat && matchBrand;
        });
      }, [products, searchQuery, selectedCategory, selectedBrand]);

      // Place Order
      const handlePlaceOrder = (e) => {
        e.preventDefault();
        if (!checkoutForm.name || !checkoutForm.phone || !checkoutForm.address) {
          alert('Please fill in your name, mobile number, and delivery address.');
          return;
        }
        if (cart.length === 0) {
          alert('Your cart is empty.');
          return;
        }

        const newOrder = {
          id: `ENX-${Math.floor(10000 + Math.random() * 90000)}`,
          date: new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }),
          customer: checkoutForm,
          items: cart,
          subtotal: cartSubtotal,
          deliveryFee: deliveryFee,
          total: orderGrandTotal,
          status: 'Pending'
        };

        setOrders(prev => [newOrder, ...prev]);
        setConfirmedOrder(newOrder);
        setCart([]);
        setIsCheckoutOpen(false);
      };

